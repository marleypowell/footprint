# Copy to .env (git-ignored), fill in, and chmod 600 .env (not needed on Windows). footprint loads
# it at start-up; variables already exported in your shell take precedence.

# Jira and Confluence. Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Only for tokens with scopes, which are made per product (replace ATLASSIAN_API_TOKEN):
# JIRA_API_TOKEN=
# CONFLUENCE_API_TOKEN=

# GitHub: optional, the gh CLI's login is used when these are unset
# GH_TOKEN=
