{
  "org": "acme",
  "login": "your-github-login",
  "identity": {
    "emails": [
      "first.last@example.com",
      "12345678+your-github-login@users.noreply.github.com"
    ],
    "names": ["First Last", "your-github-login"],
    "discovery_pattern": "first|last|your-github-login"
  },
  "code_host": {
    "kind": "github"
  },
  "catalog": {
    "kind": "backstage",
    "hub_repos": ["backstage-entities", "service-catalog"]
  },
  "issue_tracker": {
    "kind": "jira",
    "site": "example.atlassian.net",
    "extra_project_keys": ["DEV"]
  },
  "wiki": {
    "kind": "confluence",
    "site": "example.atlassian.net"
  },
  "mirror": {
    "parallelism": 6,
    "fetch_pull_refs": true
  },
  "ownership": {
    "parallelism": 4,
    "copies": true,
    "ignore_revs": [],
    "others": true
  }
}
